# ============================================================================
# PlegoHR — environment variables
# Copy this file to .env and fill in the values. Never commit .env.
# ============================================================================

# --- Supabase (browser client, safe to expose) -------------------------------
# Project settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Absolute URL of this app (used in invitation emails / links)
VITE_APP_URL=http://localhost:5173

# --- Supabase Edge Functions (server secrets) --------------------------------
# Set with:  npx supabase secrets set RESEND_API_KEY=... EMAIL_FROM=...
# Create the key at https://resend.com/api-keys
RESEND_API_KEY=re_xxx_xxxxxxxxxxxxxxxxxxxx
# Sender address. On the free Resend plan use the onboarding domain:
EMAIL_FROM=PlegoHR <onboarding@resend.dev>
# Fallback app URL used in emails when the client does not send appUrl
APP_URL=http://localhost:5173
